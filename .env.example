# Copy this file to .env.local and fill in your Supabase project values.
# Get both values from your Supabase project's Connect dialog.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Legacy fallback — use only for projects created before the publishable key was introduced.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
