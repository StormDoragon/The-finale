# Copy this file to .env.local and fill in your Supabase project values.
# Get the URL and publishable key from your Supabase project's Connect dialog.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Legacy fallback — use only for projects created before the publishable key was introduced.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required to store and read Facebook page access tokens
# (Supabase Project Settings -> API -> service_role). Never expose it in the
# browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
